# Supabase bağlantı bilgileri
# Supabase Dashboard > Project Settings > API sayfasından kopyalayın,
# bu dosyayı .env.local adıyla çoğaltıp değerleri doldurun.
# (.env.local git'e girmez; Vercel'de de aynı değişkenleri
#  Project Settings > Environment Variables altına ekleyin.)

# Project URL (örn. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "anon / publishable" anahtar — tarayıcıya gitmesi güvenli olan anahtar.
# Yeni projelerde "sb_publishable_..." ile başlar (eski adı: anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role / secret" anahtar — YALNIZCA sunucuda kullanılır, asla
# tarayıcıya gönderilmez. Yeni projelerde "sb_secret_..." ile başlar.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API anahtarı — AI ön teşhis kartı (/api/teshis) için.
# https://console.anthropic.com/settings/keys adresinden alın.
# YALNIZCA sunucuda kullanılır, asla tarayıcıya/istemciye gönderilmez.
ANTHROPIC_API_KEY=
